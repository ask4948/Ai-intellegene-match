export default {
  async fetch(request) {
    const url = new URL(request.url);

    if (url.pathname === "/api/health") {
      return Response.json({
        status: "ok",
        project: "AI Match Intelligence"
      });
    }

    return Response.json({
      project: "AI Match Intelligence",
      status: "online",
      message: "Backend is running."
    });
  }
};
